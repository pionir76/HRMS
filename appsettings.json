{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Directory": "App_Data/logs",
      "RetentionDays": 30
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "HRMS"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Communication": {
    "TestMode": false,
    "TimeoutMs": 1500
  },
  "FileStorage": {
    "RootPath": "App_Data/attachments"
  },
  "SystemStatus": {
    "StorageDrive": "C:\\"
  }
}
